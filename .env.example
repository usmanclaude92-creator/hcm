# PostgreSQL connection string. Everything the application stores lives here; without
# it the server falls back to the local JSON file, which is not durable.
# Supabase: Project Settings -> Database -> Connection string.
#   - Long-running server (this app on a VM/container): use the SESSION pooler, port 5432.
#   - Serverless (Vercel): use the TRANSACTION pooler, port 6543.
# Format: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Seconds the pool waits for a connection before failing (default 10000ms). A pooler
# waking from idle can take several seconds on the first request.
DB_CONNECT_TIMEOUT_MS=

GEMINI_API_KEY=
JWT_SECRET=
SUPABASE_RECEIPTS_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Optional. Powers the "Shift Start" / "Shift End" fields on the Workforce Deployment
# dashboard's employee cards by querying the Artify Workforce app's shift-status Edge
# Function for today's clock-in/clock-out per HCMS Employee ID. Without these, the cards
# simply show "Not Tracked" as before -- this is a read-only overlay, not a dependency.
# WORKFORCE_SHIFT_STATUS_SECRET must match the Workforce project's
# hcms_shift_status_secret Vault entry.
WORKFORCE_SHIFT_STATUS_URL=
WORKFORCE_SHIFT_STATUS_SECRET=

# Required on the first production start when no user accounts exist yet.
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_EMAIL=

# Set to true ONLY for a single-process on-premise install on durable local disk.
# With NODE_ENV=production and no DATABASE_URL, the server refuses to start unless
# this is set, because the local JSON store is not durable on a serverless or
# containerised host.
ALLOW_FILE_STORE=

# Set to true to allow accounts whose password is on the weak-password blacklist to
# sign in on a production instance. Intended only for a controlled migration window.
ALLOW_WEAK_PASSWORDS=

# Set to false to suppress the demonstration dataset outside production.
ALLOW_DEMO_SEED=
